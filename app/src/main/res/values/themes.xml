<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 底色用深色，避免 Compose 首帧白屏闪烁 -->
    <style name="Theme.MyVidHub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
    </style>

    <style name="Theme.MyVidHub.Fullscreen" parent="Theme.MyVidHub">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
